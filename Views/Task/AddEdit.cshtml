@model Mission8_Team0306.Models.TaskItem

@{
    bool isEdit = Model.TaskId != 0;
    ViewData["Title"] = isEdit ? "Edit Task" : "Add Task";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm mt-4">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">@(isEdit ? "✏️ Edit Task" : "➕ Add New Task")</h4>
                </div>

                <div class="card-body">
                    <form asp-controller="Task"
                          asp-action="@(isEdit ? "Edit" : "Create")"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="TaskId" />
                        }

                        <div class="mb-3">
                            <label asp-for="TaskName" class="form-label fw-semibold">
                                Task <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TaskName" class="form-control" placeholder="Enter task description..." />
                            <span asp-validation-for="TaskName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DueDate" class="form-label fw-semibold">Due Date</label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quadrant" class="form-label fw-semibold">
                                Quadrant <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Quadrant" class="form-select">
                                <option value="">-- Select Quadrant --</option>
                                <option value="1">Q1 – Important / Urgent</option>
                                <option value="2">Q2 – Important / Not Urgent</option>
                                <option value="3">Q3 – Not Important / Urgent</option>
                                <option value="4">Q4 – Not Important / Not Urgent</option>
                            </select>
                            <span asp-validation-for="Quadrant" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                            <select asp-for="CategoryId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="Completed" class="form-check-input" type="checkbox" />
                            <label asp-for="Completed" class="form-check-label fw-semibold">Mark as Completed</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-4">
                                @(isEdit ? "💾 Save Changes" : "✅ Add Task")
                            </button>
                            <a asp-controller="Task" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>

            <div class="card mt-3 border-0 bg-light">
                <div class="card-body py-2">
                    <small class="text-muted">
                        <strong>Quadrant Guide:</strong><br />
                        🔴 <strong>Q1</strong> – Important / Urgent &nbsp;|&nbsp;
                        🟢 <strong>Q2</strong> – Important / Not Urgent <br />
                        🟡 <strong>Q3</strong> – Not Important / Urgent &nbsp;|&nbsp;
                        ⚪ <strong>Q4</strong> – Not Important / Not Urgent
                    </small>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}