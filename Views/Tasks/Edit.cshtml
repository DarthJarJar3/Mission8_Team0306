@{
    ViewData["Title"] = "Edit Task";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">✏️ Edit Task</h4>
                </div>
                <div class="card-body">
                    <form method="post">

                        <!-- Hidden ID - IMPORTANT for edit to work -->
                        <input type="hidden" name="TaskId" value="" />
                        <!-- ^ Individual #1 will confirm the ID property name -->
                        <!-- Same fields as Create... -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Task <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="TaskName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Quadrant <span class="text-danger">*</span>
                            </label>
                            <select name="QuadrantId" class="form-select" required>
                                <option value="">-- Select Quadrant --</option>
                                <option value="1">Q1 – Important / Urgent</option>
                                <option value="2">Q2 – Important / Not Urgent</option>
                                <option value="3">Q3 – Not Important / Urgent</option>
                                <option value="4">Q4 – Not Important / Not Urgent</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="CategoryId" class="form-select">
                                <option value="">-- Select Category --</option>
                                <option value="1">Home</option>
                                <option value="2">School</option>
                                <option value="3">Work</option>
                                <option value="4">Church</option>
                            </select>
                        </div>

                        <div class="mb-4 form-check">
                            <input type="checkbox" name="Completed" class="form-check-input" />
                            <label class="form-check-label fw-semibold">Mark as Completed</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-4">💾 Save Changes</button>
                            <a href="#" class="btn btn-outline-secondary">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>